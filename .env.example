# Copy to .env.local for local development; never commit real environment files.
# For local Supabase, prefer npm run local:setup (Node 24) to obtain current keys.
# See scripts/LOCAL_TESTING.md for demo credentials and exact PowerShell commands.
# Hosted deployment: see PRODUCTION.md. Set all five values in Vercel's target
# environment BEFORE building. Never deploy .env.local or .env.demo.local.
# Both values are required only when a Supabase client is used.
# Supabase Dashboard > project > Connect: Project URL and publishable API key.
# These values are public and safe in browser code; database access requires RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: Dashboard > Settings > API Keys. A secret key (sb_secret_...)
# or legacy service-role key belongs here, NEVER in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Exact origin for CSRF validation and public location QR URLs; no trailing slash.
# HTTPS on deployed sites. Use the customer-reachable application origin.
# In Vercel replace localhost with your single canonical https://app-domain.
# Preview must use a separate Supabase project and its own exact HTTPS origin.
APP_ORIGIN=http://localhost:3000

# Server only: generate at least 32 random bytes, e.g. node crypto.randomBytes.
# Used to HMAC rate-limit identifiers, including public customer request IPs.
# Production preflight expects 32 random bytes (64 hex or 43 base64url characters).
# Raw Staff IDs/emails/IPs aren't stored in throttling records.
AUTH_RATE_LIMIT_SECRET=
